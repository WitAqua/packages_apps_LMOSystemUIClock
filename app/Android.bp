package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "LMOSystemUIClock",
    srcs: ["src/main/java/**/*.kt"],
    resource_dirs: ["src/main/res"],
    manifest: "src/main/AndroidManifest.xml",
    use_resource_processor: true,
    libs: [
        "SystemUIPluginLib",
    ],
    static_libs: [
        "SystemUISharedLib",
    ],
    // Required to compile the @Composable lockscreen elements. Compose itself stays compile-only:
    // SystemUI serves those classes to plugins at runtime, see PluginInstance.FILTERED_PACKAGES.
    kotlin_plugins: [
        "kotlin-compose-compiler-plugin",
    ],
    certificate: "platform",
    optimize: {
        enabled: false,
    },
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
}
